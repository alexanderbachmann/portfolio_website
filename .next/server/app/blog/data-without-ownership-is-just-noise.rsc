7:["$","main",null,{"className":"section blog-post","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Data Without Ownership Is Just Noise\",\"description\":\"Why most data initiatives stall — and how treating data as a product with a real owner changes the outcome.\",\"datePublished\":\"2026-08-29\",\"author\":{\"@type\":\"Person\",\"name\":\"Janio Martinez Bachmann\",\"url\":\"https://portfolio-website-two-hazel-81.vercel.app\"},\"url\":\"https://portfolio-website-two-hazel-81.vercel.app/blog/data-without-ownership-is-just-noise\"}"}}],["$","header",null,{"className":"blog-post-header","children":[["$","$L5",null,{"href":"/blog","className":"blog-back","children":"← All posts"}],["$","div",null,{"className":"post-card-meta","children":[["$","time",null,{"dateTime":"2026-08-29","children":"August 29, 2026"}],["$","span",null,{"aria-hidden":true,"children":"·"}],["$","span",null,{"children":"2 min read"}]]}],["$","h1",null,{"children":"Data Without Ownership Is Just Noise"}],["$","div",null,{"className":"post-card-tags","children":[["$","span","data products",{"className":"post-tag","children":"data products"}],["$","span","product ownership",{"className":"post-tag","children":"product ownership"}]]}]]}],["$","article",null,{"className":"prose","children":"$L11"}]]}]
