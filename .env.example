# Copy this file to .env.local (git-ignored) and fill in the values.
# On Vercel these are injected automatically (Sensitive, so they cannot be pulled
# with `vercel env pull`); a custom prefix such as neonjaniodb_DATABASE_URL also works.

# Vercel > Storage > Neon database > Quickstart > ".env.local" tab
DATABASE_URL=

# Vercel > Storage > Blob store > Quickstart (only needed locally; Vercel uses OIDC)
BLOB_READ_WRITE_TOKEN=

# Set manually in Vercel > Settings > Environment Variables (mark as Sensitive)
# AUTH_SECRET: openssl rand -base64 32   (at least 32 characters)
AUTH_SECRET=
# ADMIN_PASSWORD: the password you type at /admin/login
ADMIN_PASSWORD=
